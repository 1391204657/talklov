# Copy to .env.local and fill in. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LiveKit Cloud (https://cloud.livekit.io) — required for real audio/video media
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional AI (also powers content moderation for images + nuanced text)
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_MODERATION_MODEL=omni-moderation-latest
# AI_FORCE_OPENAI_MODERATION=1
