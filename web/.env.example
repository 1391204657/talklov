# Copy to .env.local and fill in. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LiveKit Cloud (https://cloud.livekit.io) — required for real audio/video media
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# App URL (Stripe redirects)
NEXT_PUBLIC_APP_URL=https://talklov.com

# Supabase service role (Stripe webhooks update profiles)
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe (https://dashboard.stripe.com) — subscriptions & one-time boosts
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_VIP_MONTH_US=price_...
# STRIPE_PRICE_VIP_QUARTER_US=price_...
# STRIPE_PRICE_VIP_YEAR_US=price_...
# STRIPE_PRICE_BOOST_US=price_...
# STRIPE_PRICE_VIP_MONTH_CN=price_...
# STRIPE_PRICE_VIP_INTRO_CN=price_...
# STRIPE_PRICE_BOOST_CN=price_...
# STRIPE_PRICE_AI_CARDS_CN=price_...
