# TalkLov config — copy to .env.local and fill in.
# Without these, the app uses built-in smart fallbacks / mock data so it still runs.

# --- Supabase (backend: Auth + DB + Realtime) ---
# Project Settings → API / Connect.
# URL 必须是项目根地址，例如 https://xxxx.supabase.co
# 不要带 /rest/v1 或 /auth/v1（否则会报 Invalid path specified in request URL）
# Key 用 Publishable key（或 Legacy 的 anon key），不要用 Secret key。
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...  或  eyJhbGci...

# ============ AI ============

# --- OpenAI (blocked in mainland China; use a proxy or a domestic model there) ---
# AI_API_KEY=sk-xxxxxxxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- DeepSeek (mainland-friendly, OpenAI-compatible) ---
# AI_API_KEY=sk-xxxxxxxx
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# --- Alibaba Qwen (通义千问, OpenAI-compatible mode) ---
# AI_API_KEY=sk-xxxxxxxx
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
